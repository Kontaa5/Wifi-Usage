<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>at.datenmonitor.widget</string>

    <!-- Das Widget in der .app (nötig für die Ortungsdienste-Freigabe). __HOME__ wird beim Installieren ersetzt. -->
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/Applications/Datenmonitor.app/Contents/MacOS/datenmonitor-widget</string>
    </array>

    <!-- Nach dem Login automatisch starten und am Leben halten -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <!-- Menüleisten-App: als GUI-Hintergrundprozess laufen lassen -->
    <key>ProcessType</key>
    <string>Interactive</string>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Application Support/Datenmonitor/widget.out.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Application Support/Datenmonitor/widget.err.log</string>
</dict>
</plist>
